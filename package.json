{
  "name": "xrxs-dsh-android-publish",
  "version": "0.1.2",
  "private": true,
  "description": "DSH 插件：以安全、可审计的方式执行 Android 打包与商店提审（应用宝 / 小米 / 华为 / OPPO / vivo），凭据全程脱敏并强制人工审批",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AngChow/xrxs-dsh-android-publish.git"
  },
  "bugs": {
    "url": "https://github.com/AngChow/xrxs-dsh-android-publish/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "android",
    "apk",
    "app-store",
    "release"
  ],
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "README.md",
    "locale/*.json",
    "resources/scripts/**/*",
    "resources/python/**/*",
    "resources/vendor/**/*",
    "resources/requirements.txt"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.5 <0.3.0"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepare": "pnpm run build"
  },
  "dsh": {
    "bundle": {
      "platforms": [
        "darwin"
      ],
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.5-alpha.1",
    "@deepseek-ai/dsh-credentials": ">=0.2.1-rc.5 <0.3.0",
    "@deepseek-ai/dsh-jobs": ">=0.2.1-rc.5 <0.3.0",
    "@deepseek-ai/dsh-subprocess": ">=0.2.1-rc.5 <0.3.0",
    "@deepseek-ai/dsh-system-prompt": ">=0.2.1-rc.5 <0.3.0",
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.5 <0.3.0",
    "@deepseek-ai/dsh-user-questions": ">=0.2.1-rc.5 <0.3.0",
    "@deepseek-ai/schemastery": ">=3.18.5"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.6-alpha.1",
    "@deepseek-ai/dsh-credentials": "0.2.1-rc.5",
    "@deepseek-ai/dsh-jobs": "0.2.1-rc.5",
    "@deepseek-ai/dsh-subprocess": "0.2.1-rc.5",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.5",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.5",
    "@deepseek-ai/dsh-user-questions": "0.2.1-rc.5",
    "@deepseek-ai/schemastery": "3.18.5",
    "@types/node": "^22.20.1",
    "tsdown": "^0.22.2",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
